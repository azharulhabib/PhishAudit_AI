{
  "manifest_version": 3,
  "name": "PhishAudit AI",
  "version": "1.0",
  "description": "Real-time phishing URL detection using machine learning.",
  "permissions": [
        "webNavigation",
        "notifications",
        "storage",
        "tabs",
        "activeTab"
    ],
  "host_permissions": [
        "http://localhost:8000/*"
    ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
        "48": "icons/icon48.png"
    },
    "default_title": "PhishAudit AI"
    },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "48": "icons/icon48.png"
  }
}